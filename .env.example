# Stock AI Environment Variables
# Copy this file to .env and update the values

# Environment
ENVIRONMENT=development

# API Configuration
JWT_SECRET_KEY=your-secret-key-change-this-in-production
STOCK_AI_API_KEY=your-api-key-here

# Database
DATABASE_URL=postgresql://stockai:password@localhost:5432/stockai

# Redis
REDIS_URL=redis://localhost:6379

# External APIs (optional)
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
QUANDL_API_KEY=your-quandl-key

# Docker-specific (used in docker-compose.yml)
POSTGRES_DB=stockai
POSTGRES_USER=stockai
POSTGRES_PASSWORD=password

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging
LOG_LEVEL=INFO