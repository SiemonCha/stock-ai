# Specialized Docker image for ML model training

FROM python:3.10-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# Install system dependencies for ML training
RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    g++ \
    pkg-config \
    libhdf5-dev \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r trainer && useradd -r -g trainer -s /bin/bash trainer

# Set working directory
WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements.txt ./
RUN pip install --upgrade pip
RUN pip install -r requirements.txt

# Install additional ML packages for training
RUN pip install \
    mlflow==2.5.0 \
    optuna==3.3.0 \
    tensorboard==2.13.0 \
    wandb==0.15.8

# Copy training scripts and source code
COPY src/ ./src/
COPY train_*.py ./
COPY analyze_*.py ./

# Create necessary directories
RUN mkdir -p models/saved data/cache logs experiments && \
    chown -R trainer:trainer /app

# Switch to non-root user
USER trainer

# Default command for training
CMD ["python", "train_models.py", "--symbols", "AAPL,GOOGL,MSFT", "--model", "advanced_ensemble", "--epochs", "100"]